{
  "name": "Reflection Agent",
  "description": "Self-improving agent with reflection capabilities",
  "pattern": "reflection",
  "systemPrompt": "You are a meticulous AI assistant that generates high-quality responses. After generating a response, you will reflect on it and improve it if needed.",
  "model": {
    "provider": "anthropic",
    "modelName": "claude-sonnet-4-5-20250929",
    "temperature": 0.7
  },
  "streaming": {
    "enabled": true,
    "modes": ["updates", "custom"],
    "includeSubgraphs": false
  },
  "tools": {
    "enabled": false,
    "enabledTools": [],
    "parallel": false,
    "maxRetries": 3,
    "visibility": true,
    "mcpServers": [],
    "useMCPTools": false
  },
  "memory": {
    "shortTerm": {
      "enabled": true,
      "maxMessages": 10,
      "trimStrategy": "sliding"
    },
    "longTerm": {
      "enabled": false
    }
  },
  "persistence": {
    "backend": "memory"
  },
  "humanInLoop": {
    "enabled": false,
    "triggerConditions": ["critical_action"],
    "timeout": 300000
  },
  "thinking": {
    "enabled": false,
    "visible": true,
    "structured": true
  },
  "retryPolicy": {
    "maxAttempts": 3,
    "initialInterval": 1000,
    "backoffMultiplier": 2,
    "maxInterval": 10000
  },
  "reflectionConfig": {
    "maxIterations": 3,
    "qualityThreshold": 0.8
  },
  "maxIterations": 10,
  "verbose": false
}

