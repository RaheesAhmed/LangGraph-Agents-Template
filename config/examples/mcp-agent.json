{
  "name": "MCP-Enabled Agent",
  "description": "Agent configured to use external MCP servers",
  "pattern": "react",
  "systemPrompt": "You are a helpful AI assistant with access to tools through MCP servers.",
  "model": {
    "provider": "anthropic",
    "modelName": "claude-sonnet-4-5-20250929",
    "temperature": 0.7
  },
  "streaming": {
    "enabled": true,
    "modes": ["updates", "messages"],
    "includeSubgraphs": false
  },
  "tools": {
    "enabled": true,
    "enabledTools": ["calculator"],
    "parallel": false,
    "maxRetries": 3,
    "visibility": true,
    "useMCPTools": true,
    "mcpServers": [
      {
        "name": "example_mcp_server",
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-example"]
      }
    ]
  },
  "memory": {
    "shortTerm": {
      "enabled": true,
      "maxMessages": 10,
      "trimStrategy": "sliding"
    },
    "longTerm": {
      "enabled": false
    }
  },
  "persistence": {
    "backend": "memory"
  },
  "humanInLoop": {
    "enabled": false,
    "triggerConditions": ["critical_action"],
    "timeout": 300000
  },
  "thinking": {
    "enabled": false,
    "visible": true,
    "structured": true
  },
  "retryPolicy": {
    "maxAttempts": 3,
    "initialInterval": 1000,
    "backoffMultiplier": 2,
    "maxInterval": 10000
  },
  "maxIterations": 15,
  "verbose": false
}

