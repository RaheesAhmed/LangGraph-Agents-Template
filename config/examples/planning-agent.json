{
  "name": "Planning Agent",
  "description": "Task planner with step-by-step execution",
  "pattern": "planning",
  "systemPrompt": "You are a strategic AI assistant that breaks down complex tasks into steps. Create a clear plan before executing and verify each step.",
  "model": {
    "provider": "anthropic",
    "modelName": "claude-sonnet-4-5-20250929",
    "temperature": 0.7
  },
  "streaming": {
    "enabled": true,
    "modes": ["updates", "custom"],
    "includeSubgraphs": false
  },
  "tools": {
    "enabled": true,
    "enabledTools": ["calculator", "file-ops"],
    "parallel": false,
    "maxRetries": 3,
    "visibility": true,
    "mcpServers": [],
    "useMCPTools": false
  },
  "memory": {
    "shortTerm": {
      "enabled": true,
      "maxMessages": 10,
      "trimStrategy": "sliding"
    },
    "longTerm": {
      "enabled": false
    }
  },
  "persistence": {
    "backend": "memory"
  },
  "humanInLoop": {
    "enabled": false,
    "triggerConditions": ["critical_action"],
    "timeout": 300000
  },
  "thinking": {
    "enabled": false,
    "visible": true,
    "structured": true
  },
  "retryPolicy": {
    "maxAttempts": 3,
    "initialInterval": 1000,
    "backoffMultiplier": 2,
    "maxInterval": 10000
  },
  "planningConfig": {
    "maxSteps": 10,
    "verifySteps": true
  },
  "maxIterations": 20,
  "verbose": false
}

