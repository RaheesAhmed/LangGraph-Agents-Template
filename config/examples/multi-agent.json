{
  "name": "Multi-Agent System",
  "description": "Supervisor coordinating multiple specialized workers",
  "pattern": "multi-agent",
  "systemPrompt": "You are a supervisor coordinating multiple specialized agents. Delegate tasks to the appropriate worker based on their expertise.",
  "model": {
    "provider": "anthropic",
    "modelName": "claude-sonnet-4-5-20250929",
    "temperature": 0.7
  },
  "streaming": {
    "enabled": true,
    "modes": ["updates", "custom"],
    "includeSubgraphs": false
  },
  "tools": {
    "enabled": false,
    "enabledTools": [],
    "parallel": false,
    "maxRetries": 3,
    "visibility": true,
    "mcpServers": [],
    "useMCPTools": false
  },
  "memory": {
    "shortTerm": {
      "enabled": true,
      "maxMessages": 10,
      "trimStrategy": "sliding"
    },
    "longTerm": {
      "enabled": false
    }
  },
  "persistence": {
    "backend": "memory"
  },
  "humanInLoop": {
    "enabled": false,
    "triggerConditions": ["critical_action"],
    "timeout": 300000
  },
  "thinking": {
    "enabled": false,
    "visible": true,
    "structured": true
  },
  "retryPolicy": {
    "maxAttempts": 3,
    "initialInterval": 1000,
    "backoffMultiplier": 2,
    "maxInterval": 10000
  },
  "multiAgentConfig": {
    "workers": [
      {
        "name": "researcher",
        "role": "Research information and gather facts",
        "tools": ["web-search"]
      },
      {
        "name": "calculator",
        "role": "Perform mathematical calculations",
        "tools": ["calculator"]
      },
      {
        "name": "writer",
        "role": "Write and format content",
        "tools": ["file-ops"]
      }
    ],
    "maxParallelWorkers": 2
  },
  "maxIterations": 20,
  "verbose": false
}

