{
  "name": "Default ReAct Agent",
  "description": "A configurable agent template using the ReAct pattern",
  "pattern": "react",
  "systemPrompt": "You are a helpful AI assistant that can use tools to accomplish tasks. Think step by step and use the available tools when needed.",
  "model": {
    "provider": "anthropic",
    "modelName": "claude-sonnet-4-5-20250929",
    "temperature": 0.7
  },
  "streaming": {
    "enabled": true,
    "modes": ["updates", "messages"],
    "includeSubgraphs": false
  },
  "tools": {
    "enabled": true,
    "enabledTools": ["calculator", "web-search", "file-ops"],
    "parallel": false,
    "maxRetries": 3,
    "visibility": true
  },
  "memory": {
    "shortTerm": {
      "enabled": true,
      "maxMessages": 10,
      "trimStrategy": "sliding"
    },
    "longTerm": {
      "enabled": false
    }
  },
  "persistence": {
    "backend": "memory"
  },
  "humanInLoop": {
    "enabled": false
  },
  "thinking": {
    "enabled": false,
    "visible": true
  },
  "retryPolicy": {
    "maxAttempts": 3,
    "initialInterval": 1000
  },
  "maxIterations": 15,
  "verbose": false
}

